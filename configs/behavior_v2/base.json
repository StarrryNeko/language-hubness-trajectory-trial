{
  "extends": "../base_24lang_same_semantics.json",
  "device": "auto",
  "dtype": "bfloat16",
  "storage_dtype": "float32",
  "dataset": {
    "split": "devtest",
    "sample_size_per_language": 804,
    "sample_selection": {
      "strategy": "random_without_replacement",
      "seed": 20260809,
      "exclude_manifest_paths": []
    }
  },
  "metrics": {
    "representations": ["mean_pool"],
    "primary_representation": "mean_pool"
  },
  "behavior_v2": {
    "enabled": true,
    "result_directory": "behavior_v2",
    "seed": 20260809,
    "role_assignment_seed": 20260809,
    "source_languages": ["zh", "ar", "hi", "es", "ru", "sw", "tr", "ja"],
    "non_latin_target_languages": ["zh", "ar", "hi", "ru", "ja"],
    "language_names": {
      "en": "English",
      "zh": "Chinese",
      "ar": "Arabic",
      "hi": "Hindi",
      "es": "Spanish",
      "ru": "Russian",
      "sw": "Swahili",
      "tr": "Turkish",
      "ja": "Japanese"
    },
    "demonstration_semantic_ids": 4,
    "evaluation_semantic_ids": 800,
    "prompt_template": "{demonstrations}\n\n{source_name}: {source_text}\n{target_name}:",
    "decoding": {
      "do_sample": false,
      "num_beams": 1,
      "max_new_tokens": 256,
      "use_cache": true,
      "prompt_add_special_tokens": false,
      "allow_natural_termination": true,
      "max_prompt_tokens": 2048
    },
    "generation_runtime": {
      "batch_size": 32,
      "minimum_batch_size": 1,
      "oom_backoff": true,
      "maximum_gpu_memory_gib": 76.0
    },
    "local_scaling_k": 5,
    "k_sensitivity": [3, 5, 10],
    "bootstrap_samples": 1000,
    "confidence_level": 0.95,
    "maximum_empty_output_rate": 0.01,
    "maximum_token_budget_rate": 0.01,
    "resources": {
      "cpu_threads": 24,
      "geometry_device": "cuda",
      "geometry_dtype": "float32",
      "allow_tf32": false
    },
    "lexical_leakage": {
      "minimum_latin_run_words": 3,
      "require_english_function_word": true,
      "rule_version": "strong_marker_or_two_function_words_v1",
      "audit_negative_per_language": 60,
      "validation_report": "lexical_detector_validation.json",
      "minimum_precision": 0.90,
      "minimum_recall": 0.80,
      "maximum_false_positive_rate": 0.01
    }
  },
  "token_export": {"enabled": false}
}
