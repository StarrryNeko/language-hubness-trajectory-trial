    "maximum_empty_output_rate": 0.01,
    "resources": {
      "cpu_threads": 24,
      "evaluation_workers": 24,
      "geometry_device": "cuda",
      "geometry_dtype": "float32",
      "allow_tf32": false
    },
    "language_id": {
